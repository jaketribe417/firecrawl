# Firecrawl Self-Host Configuration
# Copy to .env and fill in your values

# ===== Required =====
PORT=3002
HOST=0.0.0.0
INTERNAL_PORT=3002
USE_DB_AUTHENTICATION=false
LOGGING_LEVEL=info

# ===== Passwords — generate with: openssl rand -hex 32 =====
BULL_AUTH_KEY=change-this-to-a-long-random-string

# PostgreSQL
POSTGRES_DB=firecrawl
POSTGRES_USER=firecrawl
POSTGRES_PASSWORD=change-this-to-a-strong-password

# RabbitMQ — must match NUQ_RABBITMQ_URL in docker-compose
RABBITMQ_USER=firecrawl
RABBITMQ_PASSWORD=change-this-to-a-strong-password

# ===== Boolean flags — must be explicit true/false, never empty =====
# Empty string causes ZodError crash in API container
BLOCK_MEDIA=false
ALLOW_LOCAL_WEBHOOKS=false

# ===== Optional: AI features =====
# OpenAI cloud:
# OPENAI_API_KEY=sk-...
# Ollama local:
# OLLAMA_BASE_URL=http://host.docker.internal:11434/api
# MODEL_NAME=qwen3:32b
# MODEL_EMBEDDING_NAME=nomic-embed-text

# ===== Optional: Proxy =====
# PROXY_SERVER=http://10.0.0.1:3128
# PROXY_USERNAME=
# PROXY_PASSWORD=

# ===== Optional: SearXNG for /search endpoint =====
# SEARXNG_ENDPOINT=http://your-searxng-host